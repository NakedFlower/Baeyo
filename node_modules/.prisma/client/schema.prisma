// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String?
  avatar    String?
  phone     String?
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  posts          Post[]
  participations Participation[]
  chatRooms      ChatRoomMember[]
  messages       Message[]
  reviews        Review[]
  writtenReviews Review[]         @relation("ReviewWriter")

  @@map("users")
}

model Post {
  id              String   @id @default(cuid())
  title           String
  description     String
  price           Int
  minPeople       Int
  maxPeople       Int
  currentPeople   Int      @default(1)
  imageUrl        String?
  pickupLocation  String
  pickupLatitude  Float?
  pickupLongitude Float?
  deadline        DateTime
  status          String   @default("RECRUITING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 관계
  authorId       String
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  participations Participation[]
  chatRoom       ChatRoom?

  @@map("posts")
}

model Participation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 관계
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("participations")
}

model ChatRoom {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  postId   String           @unique
  post     Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  members  ChatRoomMember[]
  messages Message[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  // 관계
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@unique([userId, chatRoomId])
  @@map("chat_room_members")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // 관계
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5 평점
  comment   String?
  createdAt DateTime @default(now())

  // 관계
  revieweeId String // 리뷰 받는 사람
  reviewee   User   @relation(fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId String // 리뷰 작성하는 사람
  reviewer   User   @relation("ReviewWriter", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([revieweeId, reviewerId])
  @@map("reviews")
}
